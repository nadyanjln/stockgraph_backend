{
  "functions": {
    "app/main.py": {
      "excludeFiles": "{node_modules/**,.venv/lib/python*/site-packages/torch/**,.venv/lib/python*/site-packages/nvidia/**,.venv/lib/python*/site-packages/transformers/**,.venv/lib/python*/site-packages/triton/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "app/main.py"
    }
  ]
}
